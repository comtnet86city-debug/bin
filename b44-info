#!/bin/bash
# Base44 / Hermes Dashboard API 連線資訊工具

TOKEN=$(cat ~/.hermes_token 2>/dev/null || echo "Token 尚未產生，請先啟動 Dashboard")
LOCAL_URL="http://localhost:7860"
TAILSCALE_IP=$(ip addr show tailscale0 2>/dev/null | awk '/inet /{print $2}' | cut -d/ -f1)
TAILSCALE_URL="${TAILSCALE_IP:+http://$TAILSCALE_IP:7860}"
PUBLIC_IP=$(ip addr show enp5s0 2>/dev/null | awk '/inet /{print $2}' | cut -d/ -f1)

# 測試 Dashboard 是否在線
DASH_CODE=$(curl -s -o /dev/null -w "%{http_code}" --max-time 2 "${LOCAL_URL}/api/system" 2>/dev/null)
[ "$DASH_CODE" = "200" ] && DASH_STATUS="✅ 運行中" || DASH_STATUS="❌ 離線（執行 bash ~/hermes-dashboard/start.sh 啟動）"

clear
echo ""
echo "  ╔══════════════════════════════════════════════════════════╗"
echo "  ║           Hermes Dashboard ── Base44 API 資訊           ║"
echo "  ╚══════════════════════════════════════════════════════════╝"
echo ""
echo "  📡  Dashboard 狀態：${DASH_STATUS}"
echo ""
echo "  ───────────────── 連線位址 ─────────────────"
echo "  本機（瀏覽器）:  ${LOCAL_URL}"
[ -n "$TAILSCALE_URL" ] && echo "  Tailscale（遠端）: ${TAILSCALE_URL}"
[ -n "$PUBLIC_IP" ]     && echo "  公網 IP:           http://${PUBLIC_IP}:7860  ⚠ 需開放 7860 port"
echo ""
echo "  ───────────────── API Token ────────────────"
echo "  ${TOKEN}"
echo ""
echo "  用法：所有 /api/b44/* 請求需加入 Header："
echo "    X-Api-Key: ${TOKEN}"
echo ""
echo "  ─────────────── Base44 設定步驟 ────────────"
echo "  1. 前往 https://base44.com 建立 App"
echo "  2. 在 App 的 API 設定中填入 Base URL："
[ -n "$TAILSCALE_URL" ] && echo "       ${TAILSCALE_URL}  ← Tailscale（推薦）"
echo "       ${LOCAL_URL}       ← 僅限本機"
echo "  3. 加入 HTTP Header：X-Api-Key: ${TOKEN}"
echo "  4. 使用以下端點建構你的 App："
echo ""
echo "  ─────────────── 可用 API 端點 ──────────────"
echo ""
echo "  [GET]  /api/b44/token-info          驗證 Token，確認服務狀態"
echo "  [GET]  /api/b44/system              系統即時快照（CPU/RAM/GPU）"
echo "  [GET]  /api/b44/files               列出桌面輸出檔（含下載連結）"
echo "  [GET]  /api/b44/job/{job_id}        查詢非同步任務進度"
echo "  [POST] /api/b44/run-task            觸發 AI 任務（見下方範例）"
echo ""
echo "  ─────────────── run-task 任務類型 ──────────"
echo "  task_type      說明"
echo "  ppt            生成 AI 結構化 PPT（需提供 topic）"
echo "  ppt_webdesign  靜態網頁設計提案 PPT"
echo "  excel          生成 AI Excel 報表（需提供 topic）"
echo "  server_check   Qwen 伺服器磁碟巡檢"
echo "  server_hermes  Hermes3 伺服器磁碟巡檢（輕量）"
echo "  rag            RAG 知識庫查詢（需提供 topic 作為問題）"
echo ""
echo "  ─────────────── 快速測試指令 ───────────────"
BASE="${TAILSCALE_URL:-$LOCAL_URL}"
echo ""
echo "  # 1. 驗證 Token"
echo "  curl -s ${BASE}/api/b44/token-info \\"
echo "       -H 'X-Api-Key: ${TOKEN}' | jq ."
echo ""
echo "  # 2. 觸發 PPT 任務"
echo "  curl -s -X POST ${BASE}/api/b44/run-task \\"
echo "       -H 'X-Api-Key: ${TOKEN}' \\"
echo "       -H 'Content-Type: application/json' \\"
echo "       -d '{\"task_type\":\"ppt\",\"topic\":\"淡江大橋\",\"options\":{}}' | jq ."
echo ""
echo "  # 3. 查詢任務狀態（替換 job_id）"
echo "  curl -s ${BASE}/api/b44/job/b44_final_agent_20240101_120000 \\"
echo "       -H 'X-Api-Key: ${TOKEN}' | jq .status"
echo ""
echo "  # 4. 列出輸出檔案"
echo "  curl -s ${BASE}/api/b44/files \\"
echo "       -H 'X-Api-Key: ${TOKEN}' | jq '.[].name'"
echo ""
echo "  ─────────────────────────────────────────────"
echo ""
read -rp "  按 Enter 關閉..."
